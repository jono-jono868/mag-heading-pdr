  "jump_threshold_deg": {
   "drop_jumps_2_5_sigma": 21.085028460119815,
   "drop_jumps_3_sigma": 25.302034152143776,
   "drop_jumps_4_sigma": 33.7360455361917
  }
 },
 "definitions": {
  "groups": "補正なしの遅い方位誤差（RMS）による事後の層別。設計データは 5° 以下・5° 超 10° 以下・10° 超、学習データは 10° 超とそれ以外（10° 以下）。探索的な分析",
  "adopted": "提案した方位補正の採用した設定（観測雑音の標準偏差 29.8°）",
  "observation_noise_7_5deg": "カルマンフィルタ・補正点・外れ値への重みの下げ方は採用した設定のまま、観測雑音の標準偏差だけを 7.5° にした",
  "median_of_last_3": "補正点ごとに、直近 3 点の補正点の観測が示す方位のずれ（最初の補正点の観測との差）の円形の中央値に補正角を合わせ直し、次の補正点まで保持する。補正点が 2 点のあいだは円形平均、1 点のあいだは 0。最初の補正点より前は 0",
  "latest_1_point": "補正点ごとに、その点の観測が示す方位のずれに補正角を合わせ直す。変種",
  "median_of_last_5": "直近 5 点の中央値。変種",
  "drop_jumps": "観測が示すずれが、いまの補正角から閾値を超えて跳ぶ補正点は使わず保留し、次の補正点が閾値以内で一致したら 2 点の円形平均に合わせる。閾値は、学習データのずれの小さい群での跳びの頑健な標準偏差 σ（MAD×1.4826）の 2.5・3・4 倍。変種",
  "difference": "方式 − 採用した設定。負なら小さい。HL は Hodges–Lehmann 推定量。changed_only は零でない対（|差| が閾値以上）だけの HL と Wilcoxon 検定の p（exact。零でない対が 50 を超えるときは正規近似。多重比較の補正前）。all_pairs は全系列の HL と系列のブートストラップの 95% 信頼区間。変化した系列が 6 以下の群は test_valid が false で検定が成り立たない",
  "subject_level_p": "被験者ごとに差の平均を取り、符号を入れ替える全通りで数えた両側 p",
  "holm": "学習データの 10° 超の群で試した 7 通りの、遅い方位誤差の差の p に Holm の方法をかけた値",
  "position_error": "ATE（RoNIN 公式の定義）[m]",
  "correction_points": "設計データは直進判定器と評価器が選んだ補正点。学習データは正解の直進区間を候補にし、評価器は被験者単位の交差検証の予測を使った再構成で、実際の運用より有利。学習データは RoNIN の学習に使った系列"
 },
