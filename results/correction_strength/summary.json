  "median_window_points": 3,
  "huber_c": 1.345,
  "correction_point_error_threshold_deg": 5.33,
  "zero_difference_slow_error_deg": 0.001,
  "zero_difference_position_error_m": 0.0001,
  "large_change_m": 0.128,
  "non_inferiority_margin_m": 0.0295,
